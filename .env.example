# Copy to .env (local) or set these in Cloud Run/your environment.
# JWT
JWT_SECRET_KEY=change-me-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# NOTE: Current app uses SQLite. On Cloud Run this is ephemeral unless you mount a persistent volume.
# For production, you should switch to Cloud SQL / Postgres.
DATABASE_URL=sqlite:///./app.db

# CORS
# Set this to your deployed frontend origin (Cloud Storage URL or custom domain)
FRONTEND_ORIGINS=http://localhost:5173

# Cloud Run
# Cloud Run injects PORT automatically; no need to set.

